{
  "manifest_version": 3,
  "name": "캠퍼제이 답방 매니저",
  "version": "1.1.0",
  "description": "네이버 블로그 공개 글 URL로 댓글 초안을 만드는 개인용 반자동 도구",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*"
  ],
  "action": {
    "default_title": "캠퍼제이 답방 매니저",
    "default_popup": "popup.html"
  }
}